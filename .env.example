POSTGRES_DB=bludm
POSTGRES_USER=bludm
POSTGRES_PASSWORD=change-this-postgres-password
WEB_PORT=3080

# DATABASE_URL can override the DATABASE_* settings below. Usually leave it blank in Docker.
DATABASE_URL=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=bludm
DATABASE_USER=bludm
DATABASE_PASSWORD=change-this-postgres-password
DATABASE_SSLMODE=disable
SESSION_SECRET=change-this-to-a-long-random-session-secret-at-least-32-chars
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:3080
LOCAL_AUTH_ENABLED=true

# Production HTTPS deployments should set:
# COOKIE_SECURE=true
# PUBLIC_APP_URL=https://your-public-domain.example

# Local password registration. Leave enabled for self-host fallback accounts; disable only when
# OAuth is configured and you do not want username/password sign-up.
ADMIN_EMAIL=dm@example.test
ADMIN_PASSWORD=change-this-admin-password-at-least-12-chars

# Optional OAuth sign-in providers. Redirect URIs:
# Google: ${PUBLIC_APP_URL}/api/auth/google/callback
# Discord: ${PUBLIC_APP_URL}/api/auth/discord/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# MCP and external authoring API. OIDC is optional for public/remote clients; local Codex can use
# a scoped bludm_v1_ token created in Settings.
MCP_RESOURCE_URL=http://localhost:3080/mcp
MCP_MAX_REQUEST_BYTES=4194304
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_READ_REQUESTS_PER_MINUTE=240
MCP_WRITE_REQUESTS_PER_MINUTE=60
MCP_GENERATION_REQUESTS_PER_MINUTE=20
MCP_AUTH_FAILURES_PER_MINUTE=20
MCP_OIDC_ENABLED=false
MCP_OIDC_ISSUER=
MCP_OIDC_AUDIENCE=
TRUST_FORWARDED_HEADERS=false

POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14
