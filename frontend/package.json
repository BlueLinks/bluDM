{
  "name": "bludm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "audit:security": "node ../scripts/check-frontend-audit.mjs",
    "check:size": "node ../scripts/check-file-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --ignore-path ../.prettierignore --ignore-unknown --write . ../AGENTS.md ../CODEX_PROMPTS.md ../CONTRIBUTING.md ../scripts/*.mjs ../.github/pull_request_template.md ../.prettierrc.json",
    "format:check": "prettier --ignore-path ../.prettierignore --ignore-unknown --check . ../AGENTS.md ../CODEX_PROMPTS.md ../CONTRIBUTING.md ../scripts/*.mjs ../.github/pull_request_template.md ../.prettierrc.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.8"
  }
}
